      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does carpet cleaning cost in Medford, Oregon?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most Medford homes run Competitive local rate for a full residential carpet clean. We confirm the cost before starting — based on your specific carpet type, square footage, and soil level. Affordable and transparent, with no surprises."
          }
        },
        {
          "@type": "Question",
          "name": "How long does carpet cleaning take to dry in Medford?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "During Medford summers — 80–100°F — carpets dry in 2–4 hours. During cooler months and winter temperature inversions, expect 6–8 hours. Running ceiling fans and opening windows speeds it up."
          }
        },
        {
          "@type": "Question",
          "name": "Can carpet cleaning remove wildfire smoke smell?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — but it requires the right process. Wildfire smoke deposits PM2.5 particles deep in carpet fibers. Truck-mounted extraction at 195°F+ with fiber-level deodorizer is what actually eliminates the smoke odor. Our most common call after Jackson County smoke events each July–September."
          }
        },
        {
          "@type": "Question",
          "name": "Can professional cleaning remove pet urine odor permanently?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In most cases yes — with correct enzyme treatment and sub-surface extraction. Cat and dog urine need different formulas. If the sub-floor has been saturated over years, we'll tell you honestly whether cleaning or replacement makes more sense."
          }
        },
        {
          "@type": "Question",
          "name": "What's the difference between your cleaning and a Rug Doctor rental?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Temperature and suction. Rug Doctor delivers water at ~100°F. Our truck-mounted system runs at 195–240°F with 5–10x the suction power — your carpet comes out cleaner, dries faster, and doesn't get the sticky residue that makes carpets re-soil quickly."
          }
        },
        {
          "@type": "Question",
          "name": "Do you serve all Medford zip codes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We serve 97501, 97502, 97503, and 97504, plus Ashland, Central Point, Jacksonville, Eagle Point, Talent, Phoenix, Rogue River, and throughout Jackson County."
          }
        }
      ]
